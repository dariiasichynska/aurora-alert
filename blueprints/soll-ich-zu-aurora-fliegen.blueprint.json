      "id": 2,
      "module": "http:MakeRequest",
      "version": 4,
      "parameters": {
        "tlsType": "",
        "authenticationType": "noAuth"
      },
      "mapper": {
        "url": "https://api.open-meteo.com/v1/forecast?latitude=68.35,67.86,68.42,67.80,66.50&longitude=18.83,20.23,27.42,24.80,25.73&hourly=cloud_cover,cloud_cover_low&forecast_days=3&timezone=auto",
        "method": "get",
        "shareCookies": false,
        "parseResponse": true,
        "allowRedirects": true,
        "stopOnHttpError": true,
        "requestCompressedContent": true
      },
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0
        }
      }
    },
    {
      "id": 5,
      "module": "http:MakeRequest",
      "version": 4,
      "filter": {
        "name": "Clouds low",
        "conditions": [
          [
            {
              "a": "{{2.data[1].hourly.cloud_cover_low[71]}}",
              "b": "40",
              "o": "number:less"
            }
          ],
          [
            {
              "a": "{{2.data[2].hourly.cloud_cover_low[71]}}",
              "b": "40",
              "o": "number:less"
            }
          ],
          [
            {
              "a": "{{2.data[3].hourly.cloud_cover_low[71]}}",
              "b": "40",
              "o": "number:less"
            }
          ],
          [
            {
              "a": "{{2.data[4].hourly.cloud_cover_low[71]}}",
              "b": "40",
              "o": "number:less"
            }
          ],
          [
            {
              "a": "{{2.data[5].hourly.cloud_cover_low[71]}}",
              "b": "40",
              "o": "number:less"
            }
          ]
        ]
      },
      "parameters": {
        "tlsType": "",
        "authenticationType": "noAuth"
      },
      "mapper": {
        "url": "https://services.swpc.noaa.gov/products/noaa-planetary-k-index-forecast.json",
        "method": "get",
        "shareCookies": false,
        "parseResponse": true,
        "allowRedirects": true,
        "stopOnHttpError": true,
        "requestCompressedContent": true
      },
      "metadata": {
        "designer": {
          "x": 303,
          "y": 173
        }
      }
    },
    {
      "id": 6,
      "module": "http:MakeRequest",
      "version": 4,
      "filter": {
        "name": "Kp OK",
        "conditions": [
          [
            {
              "a": "{{parseNumber(5.data[80].kp)}}",
              "b": "3.67",
              "o": "number:greaterorequal"
            }
          ]
        ]
      },
      "parameters": {
        "tlsType": "",
        "authenticationType": "noAuth"
      },
      "mapper": {
        "url": "https://services.swpc.noaa.gov/products/summary/solar-wind-speed.json",
        "method": "get",
        "shareCookies": false,
        "parseResponse": true,
        "allowRedirects": true,
        "stopOnHttpError": true,
        "requestCompressedContent": true
      },
      "metadata": {
        "designer": {
          "x": 536,
          "y": -38
        }
      }
    },
    {
